{
  "name": "codexU-web",
  "version": "1.1.0",
  "description": "Windows 版 Codex/Claude 用量可视化仪表盘 — Electron 桌面版",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "pack": "electron-builder --win portable --x64",
    "pack:installer": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.codexu.dashboard",
    "productName": "codexU-web",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "lib/**",
      "public/**",
      "build/icon.png",
      "data/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "codexU-web-portable-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "artifactName": "codexU-web-setup-${version}.exe"
    }
  },
  "license": "MIT"
}
